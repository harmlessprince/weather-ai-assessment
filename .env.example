NODE_ENV=development
PORT=3000

ADMIN_API_KEY=replace-with-a-strong-admin-key
WEATHER_AI_API_KEY=replace-with-your-weather-ai-api-key
WEATHER_AI_BASE_URL=https://api.weather-ai.co

DATABASE_PATH=data/weather-ai.sqlite

SCHEDULER_ENABLED=false
POLL_INTERVAL_MINUTES=360

ALERT_COOLDOWN_HOURS=12
MAX_DEMO_SUBSCRIPTIONS=3

EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=alerts@example.com
